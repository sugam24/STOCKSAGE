# LLM & Search API Keys
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# SEC EDGAR User-Agent (Required by SEC)
SEC_USER_AGENT=StockSage research your_email@domain.com

# StockSage FastAPI Security
STOCKSAGE_API_KEY=stocksage-dev-key-12345

# LangSmith Observability & Distributed Tracing (Day 64)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=StockSage
